datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?
  avatar    String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches   EmailBatch[]
  slacks    SlackIntegration[]
}

model Sender {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String
  etherealUser     String?
  etherealPass     String?
  hourlyRateLimit  Int      @default(200)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  emails           ScheduledEmail[]
}

model EmailBatch {
  id           String   @id @default(uuid())
  userId       String?
  subject      String
  body         String
  totalLeads   Int      @default(0)
  delaySeconds Int      @default(2)
  hourlyLimit  Int      @default(200)
  startTime    DateTime
  status       String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])
  emails       ScheduledEmail[]
}

model ScheduledEmail {
  id                 String   @id @default(uuid())
  batchId            String?
  senderId           String?
  recipientEmail     String
  subject            String
  body               String
  status             String   @default("SCHEDULED") // SCHEDULED, RESCHEDULED_RATE_LIMIT, PROCESSING, SENT, FAILED
  jobId              String?  @unique
  scheduledForTime   DateTime
  sentAt             DateTime?
  etherealMessageId  String?
  etherealPreviewUrl String?
  errorMessage       String?
  attempts           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  batch              EmailBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sender             Sender?     @relation(fields: [senderId], references: [id])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String?
  botToken    String?
  webhookUrl  String?
  channelName String?
  teamName    String?
  isEnabled   Boolean  @default(true)
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id])
}
